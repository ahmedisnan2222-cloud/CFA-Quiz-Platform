# Copy this file to .env and fill in real values before running the app.

# Postgres connection string. On a VPS, either run Postgres locally and use
# something like: postgres://user:password@localhost:5432/quizdb
# or point this at a managed Postgres (Neon, Supabase, RDS, etc.).
DATABASE_URL=""

# Any long random string, used to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=""

# The public URL this app is served at, e.g. https://quiz.yourdomain.com
NEXTAUTH_URL=""

# Used only by `npm run seed:admin` to create the instructor account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Instructor"
